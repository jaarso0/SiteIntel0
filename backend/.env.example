# Required — Knowledge Base synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# Required — Chat LLM + Voice LLM
GROQ_API_KEY=your_groq_api_key_here

# Required for voice — Streaming STT
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional — Cartesia TTS fallback (only used if Edge-TTS server is offline)
CARTESIA_API_KEY=your_cartesia_api_key_here

# LiveKit — defaults match local Docker dev setup
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional — local Edge-TTS fallback (https://github.com/travisvn/openai-edge-tts)
EDGE_TTS_URL=http://localhost:5050
EDGE_TTS_API_KEY=mykey123
